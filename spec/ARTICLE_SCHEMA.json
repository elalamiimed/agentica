{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hsiyc-article-v1",
  "title": "HSIYC bilingual approved-style article",
  "description": "The JSON contract between the generator, the validator and the renderers. Every string that reviewers read lives here.",
  "type": "object",
  "required": ["meta", "title", "lead", "sections", "closing", "signoff", "credits"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["slug", "doc_type", "generated_at", "model"],
      "additionalProperties": true,
      "properties": {
        "slug": { "type": "string", "description": "kebab-case file stem, e.g. apec-smart-campus-review" },
        "doc_type": { "enum": ["预告", "招募", "回顾", "收官", "喜报", "讲堂", "竞赛", "活动", "其他"] },
        "event_date": { "type": "string", "description": "2026年7月19日 or 2026年7月19日至21日" },
        "event_end_date": { "type": "string" },
        "venue": { "type": "string" },
        "organisers": { "type": "array", "items": { "type": "string" } },
        "partners": { "type": "array", "items": { "type": "string" } },
        "generated_at": { "type": "string" },
        "model": { "type": "string" },
        "exemplars": { "type": "array", "items": { "type": "string" }, "description": "approved articles used as style exemplars" }
      }
    },
    "title": {
      "type": "object",
      "required": ["cn"],
      "additionalProperties": false,
      "description": "Headline follows: 国际青年俱乐部 | <类型词>：<主题> (the 国际青年俱乐部 | prefix is added by the renderer if absent)",
      "properties": {
        "cn": { "type": "string" },
        "en": { "type": "string" },
        "subtitle_cn": { "type": "string" },
        "subtitle_en": { "type": "string" },
        "kicker_en": { "type": "string", "description": "short uppercase eyebrow such as APEC | FUTURE SKILLS CHALLENGE" }
      }
    },
    "lead": {
      "type": "object",
      "required": ["cn", "en"],
      "additionalProperties": false,
      "description": "The opening paragraph: for 预告/招募 the 'why' (APEC/campus framing); for 回顾/收官/喜报 the 'what happened + why it mattered'.",
      "properties": { "cn": { "type": "string" }, "en": { "type": "string" } }
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["heading_cn", "heading_en", "body"],
        "additionalProperties": false,
        "properties": {
          "number": { "type": "string", "description": "01, 02, 03 - optional, used by recap articles with distinct sub-events" },
          "heading_cn": { "type": "string" },
          "heading_en": { "type": "string" },
          "body": {
            "type": "array",
            "minItems": 1,
            "description": "Paragraph-level blocks. Order matters: it is the reading order of the article.",
            "items": {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": ["bilingual", "list", "photo_grid", "quote", "note", "divider"],
                  "description": "bilingual = one CN paragraph then its EN translation. list = ranking/name list. photo_grid = placement of photos. note = 特别感谢 / logistics. quote = pull quote. divider = section break."
                },
                "cn": { "type": "string" },
                "en": { "type": "string" },
                "items": {
                  "type": "array",
                  "description": "for kind=list: each entry is {label_cn,label_en,value_cn,value_en}",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "label_cn": { "type": "string" },
                      "label_en": { "type": "string" },
                      "value_cn": { "type": "string" },
                      "value_en": { "type": "string" }
                    }
                  }
                },
                "photos": {
                  "type": "array",
                  "description": "for kind=photo_grid: which uploaded photos go here, by filename",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "file": { "type": "string" },
                      "caption_cn": { "type": "string" },
                      "caption_en": { "type": "string" },
                      "alt": { "type": "string" }
                    }
                  }
                },
                "layout": { "enum": ["2x2", "3x1", "2x1", "3x2", "1x1", "carousel"] },
                "cn_note": { "type": "string", "description": "for kind=note" },
                "en_note": { "type": "string" }
              }
            }
          },
          "photo_placeholder": { "type": "boolean", "description": "true when the section needs photos that were not supplied" }
        }
      }
    },
    "closing": {
      "type": "object",
      "required": ["cn", "en"],
      "additionalProperties": false,
      "properties": {
        "heading_cn": { "type": "string", "default": "结语" },
        "heading_en": { "type": "string", "default": "Closing" },
        "tagline_cn": { "type": "string" },
        "tagline_en": { "type": "string" },
        "cn": { "type": "string" },
        "en": { "type": "string" }
      }
    },
    "signoff": {
      "type": "object",
      "required": ["cn", "en"],
      "additionalProperties": false,
      "properties": {
        "cn": { "type": "string", "default": "哈工大（深圳）国际青年俱乐部" },
        "en": { "type": "string", "default": "HITSZ International Youth Club" },
        "program": { "type": "string", "description": "e.g. AcademiaSphere, when the article is part of a programme" }
      }
    },
    "credits": {
      "type": "object",
      "additionalProperties": false,
      "description": "The 三审 block. Names must come from the brief or the club roster, never invented.",
      "properties": {
        "文字": { "type": "string" },
        "图片": { "type": "string" },
        "排版": { "type": "string" },
        "一审": { "type": "string" },
        "二审": { "type": "string" },
        "三审": { "type": "string" }
      }
    },
    "toc": {
      "type": "object",
      "additionalProperties": false,
      "description": "精彩回顾 · Table of Contents card: the previous/next approved articles.",
      "properties": {
        "previous": { "type": "string" },
        "next": { "type": "string" }
      }
    },
    "facts": {
      "type": "array",
      "description": "Every concrete fact used in the article, with its source. The validator cross-checks the body against this list so the model cannot smuggle in unverifiable claims.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fact": { "type": "string" },
          "source": { "type": "string", "description": "brief | photo:<file> | corpus:<slug> | unknown" }
        }
      }
    },
    "needs_editor": {
      "type": "array",
      "description": "Things the human editor must confirm before submission (missing names, missing photos, unverified numbers).",
      "items": { "type": "string" }
    }
  }
}
